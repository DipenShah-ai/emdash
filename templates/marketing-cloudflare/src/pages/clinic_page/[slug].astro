---
import { decodeSlug, getEmDashEntry, getSeoMeta } from "emdash";
import { PortableText } from "emdash/ui";
import Base from "../../layouts/Base.astro";

const slug = decodeSlug(Astro.params.slug);
if (!slug) return Astro.rewrite("/404");

const { entry: page, cacheHint } = await getEmDashEntry("clinic_page", slug);
if (!page) return Astro.rewrite("/404");
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const seo = getSeoMeta(page, {siteUrl: Astro.url.origin, path: `/clinic_page/${slug}`});
---
<Base title={seo.title} pageTitle={page.data.title} description={seo.description} canonical={seo.canonical}
  robots={seo.robots} content={{ collection: "clinic_page", id: page.data.id, slug }}>
  <article class="container" style="padding-block: 4rem 6rem; max-width: 930px;">
    <h1 {...page.edit.title}>{page.data.title}</h1>
    <div class="imported-prose" {...page.edit.content}><PortableText value={page.data.content ?? []} /></div>
  </article>
</Base>
