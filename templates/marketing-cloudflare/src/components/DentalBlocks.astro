---
interface Props { value?: any[] | null }
const { value = [] } = Astro.props;
const blocks: any[] = Array.isArray(value) ? value : [];
const treatmentLinks = [
  ["Root Canal","root-canal-treatment","🦷"],["Dental Implants","dental-implants","✨"],
  ["Clear Aligners","clear-aligners","😁"],["Teeth Whitening","teeth-whitening","☀️"],
  ["Checkup & Scaling","dental-checkup-scaling","🩺"],["Kids Dentistry","kids-dentistry","🧸"],
  ["Crowns & Veneers","crowns-and-veneers","💎"],["Gum & Wisdom Care","gum-and-wisdom-tooth-care","🌿"]
];
const symptomKeywords: Record<string, string> = {"root-canal-treatment":"Root Canal Treatment Stop Toothache & Save Your Natural Tooth — Painless Root Canal Treatment Throbbing toothache that worsens at night Lingering pain after hot tea/coffee or cold water Sharp pain when biting or chewing food Swollen gum or small pimple-like bump near a tooth Deep black cavity or cracked tooth Tooth darkening after an old injury","dental-implants":"Dental Implants Eat & Smile Naturally Again — 3D-Planned Dental Implants Single or multiple missing teeth Loose dentures slipping while speaking or eating Difficulty chewing hard foods Neighboring teeth tilting into an old gap","clear-aligners":"Clear Aligners Straighten Teeth Discreetly — Specialist-Planned Clear Aligners Crowded or overlapping teeth Visible gaps between front teeth Mild overbite or underbite Teeth shifting after childhood braces","teeth-whitening":"Teeth Whitening Safe, Sensitivity-Controlled In-Clinic Teeth Whitening Tea, coffee, or spice staining Yellowing from aging Upcoming wedding or event Dull smile despite regular brushing","dental-checkup-scaling":"Checkup & Scaling Preventive Dental Checkup & Gentle Ultrasonic Cleaning Bleeding gums while brushing Bad breath or yellow tartar 6+ months since last visit Mild occasional sensitivity","kids-dentistry":"Kids Dentistry Fear-Free Kids Dentistry for Growing Smiles First dental checkup (age 1+) Black spots or cavities on milk teeth Child complaining of pain while eating sweets Crooked incoming permanent teeth","crowns-and-veneers":"Crowns & Veneers Natural-Looking Zirconia Crowns & Porcelain Veneers Broken, chipped, or worn-down tooth Tooth needing protection after root canal Severely stained front tooth Small gaps or uneven tooth edges","gum-and-wisdom-tooth-care":"Gum & Wisdom Care Gentle Gum Treatment & Wisdom Tooth Removal Pain or swelling at the very back of the jaw Gums that bleed easily or feel tender Food constantly trapped behind back tooth Difficulty opening mouth fully"};
const whatsAppUrl = (number?: string, message = "Hello, I'd like an appointment") => {
  const digits = (number ?? "").replace(/\D/g, "");
  return /^91\d{10}$/.test(digits) ? "https://wa.me/" + digits + "?text=" + encodeURIComponent(message) : null;
};
---
<div class="dental-content">
{blocks.map((b) => (
  b._type === "dental_hero" ? (
    <section class="dental-hero">
      <div class="dental-wrap">
        <p class="eyebrow">{b.badge}</p>
        <h1>{b.heading}</h1><p class="lead">{b.subcopy}</p>
        <div class="actions">
          <a class="button primary" href={b.primaryCtaUrl || "/book-appointment"}>{b.primaryCtaLabel || "Book appointment"}</a>
          {whatsAppUrl(b.whatsappNumber) && <a class="button outline" href={whatsAppUrl(b.whatsappNumber)!}>WhatsApp</a>}
          {b.phoneNumber && !b.phoneNumber.includes("X") && <a class="button outline" href={"tel:" + b.phoneNumber}>Call clinic</a>}
        </div>
        {b.hoursText && <p class="hours">{b.hoursText}</p>}
      </div>
    </section>
  ) : b._type === "treatment_icon_grid" ? (
    <section class="dental-section dental-wrap">
      <p class="eyebrow">{b.eyebrow}</p><h2>{b.heading}</h2>
      <div class="treatments-grid">{treatmentLinks.map(([name,slug,emoji]) => (
        <a class="dental-card treatment-card" href={"/treatments/" + slug}><span aria-hidden="true" class="treatment-icon">{emoji}</span><h3>{name}</h3><span>View treatment →</span></a>
      ))}</div>
      {b.ctaUrl && <p class="bottom-link"><a href={b.ctaUrl}>{b.ctaLabel || "Explore treatments"} →</a></p>}
    </section>
  ) : b._type === "doctor_trust_snapshot" ? (
    <section class="dental-section dental-soft"><div class="dental-wrap">
      <p class="eyebrow">{b.eyebrow}</p><h2>{b.heading}</h2><p class="lead">{b.body}</p>
      <p><strong>{b.doctorName}</strong>{b.regNumber && " · " + b.regNumber}</p>
      {b.ctaUrl && <a class="button primary" href={b.ctaUrl}>{b.ctaLabel || "Learn more"}</a>}
    </div></section>
  ) : b._type === "symptom_matcher" ? (
    <section class="dental-section dental-wrap">
      <h2>{b.heading}</h2><p>{b.subcopy}</p>
      {b.enableSearch !== false && <input class="symptom-search" type="search" placeholder="Search by treatment or concern" aria-label="Search dental treatments" />}
      <div class="treatments-grid symptom-list">{treatmentLinks.map(([name,slug,emoji]) => (
        <a class="dental-card symptom-item" data-search={(name + " " + (symptomKeywords[slug] || "")).toLowerCase()} href={"/treatments/" + slug}><span aria-hidden="true">{emoji} </span>{name} →</a>
      ))}</div>
    </section>
  ) : b._type === "faq_accordion" ? (
    <section class="dental-section dental-wrap"><h2>{b.heading}</h2>
      <div class="dental-faq">{(b.items || []).map((item: any) => <details class="dental-card"><summary>{item.question}</summary><p>{item.answer}</p></details>)}</div>
    </section>
  ) : b._type === "clinic_location_cta" ? (
    <section class="dental-section dental-soft"><div class="dental-wrap">
      <h2>{b.heading}</h2>
      <div class="dental-card"><p><strong>Address:</strong> {b.address}</p>
        {b.landmark && <p><strong>Landmark:</strong> {b.landmark}</p>}
        {b.areasServed && <p><strong>Areas served:</strong> {b.areasServed}</p>}
        {b.hours && <p><strong>Hours:</strong> {b.hours}</p>}
        {b.phone && <p><strong>Phone:</strong> {b.phone}</p>}
        {b.email && <p><strong>Email:</strong> {b.email}</p>}
      </div>
    </div></section>
  ) : b._type === "appointment_widget" ? (
    <section class="dental-section dental-wrap"><h2>{b.heading}</h2>
      <p>{b.confirmationNote}</p>
      <form class="appointment-request dental-card" data-whatsapp={b.whatsappNumber || ""}>
        <label>Name <input name="name" required autocomplete="name" /></label>
        <label>Preferred day <input type="date" name="date" required /></label>
        <label>Concern <select name="concern"><option>Routine appointment</option><option>Toothache / urgent pain</option><option>Other dental treatment</option></select></label>
        <button type="submit" class="button primary">Request via WhatsApp</button>
        <p class="request-message" role="status"></p>
      </form>
      <p class="hours">This form opens WhatsApp for a request. A clinic must confirm the actual appointment; no booking is made automatically.</p>
    </section>
  ) : b._type === "rich_content_section" ? (
    <section class="dental-section dental-wrap"><p class="eyebrow">{b.eyebrow}</p><h2>{b.heading}</h2><p class="lead">{b.body}</p></section>
  ) : null
))}
</div>
<script>
  document.querySelectorAll<HTMLInputElement>(".symptom-search").forEach((input) => {
    input.addEventListener("input", () => {
      const query = input.value.toLowerCase().trim();
      input.parentElement?.querySelectorAll<HTMLElement>(".symptom-item").forEach(el => {
        const terms = query.split(/\s+/).filter(Boolean);
        const haystack = el.dataset.search || el.textContent?.toLowerCase() || "";
        el.hidden = !terms.every(term => haystack.includes(term));
      });
    });
  });
  document.querySelectorAll<HTMLFormElement>(".appointment-request").forEach(form => {
    form.addEventListener("submit", (event) => {
      event.preventDefault();
      const digits = (form.dataset.whatsapp || "").replace(/\D/g, "");
      const message = form.querySelector<HTMLElement>(".request-message");
      if (!/^91\d{10}$/.test(digits)) {
        if (message) message.textContent = "The clinic must configure its WhatsApp number before this request can be sent.";
        return;
      }
      const fd = new FormData(form);
      const text = "Appointment request: " + fd.get("name") + ", preferred day: " + fd.get("date") + ", concern: " + fd.get("concern");
      window.open("https://wa.me/" + digits + "?text=" + encodeURIComponent(text), "_blank", "noopener,noreferrer");
    });
  });
</script>
<style>
.dental-content{font-family:var(--font-body,system-ui);color:var(--color-text,#173b42)}
.dental-wrap{max-width:1160px;margin-inline:auto;padding-inline:clamp(20px,4vw,48px)}
.dental-section{padding-block:clamp(56px,7vw,90px)}
.dental-soft{background:color-mix(in srgb,var(--color-accent,#dcefed) 16%,transparent)}
.dental-hero{padding-block:clamp(90px,11vw,150px);background:linear-gradient(125deg,#eff9f8,#e7f3f7 60%,#fcfdfb);color:#123c44}
.dental-content h1{font-size:clamp(2.4rem,5vw,4.7rem);line-height:1.1;max-width:17ch;margin-block:16px 24px}
.dental-content h2{font-size:clamp(1.8rem,3.2vw,3.1rem);margin-block:12px 24px;line-height:1.16}
.dental-content h3{font-size:1.15rem;margin-block:12px}
.dental-content .eyebrow{text-transform:uppercase;letter-spacing:.14em;font-weight:700;color:#0e817f;font-size:.78rem}
.dental-content .lead{font-size:clamp(1.05rem,1.7vw,1.27rem);line-height:1.7;max-width:76ch}
.dental-content .actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:28px}
.dental-content .button{display:inline-block;padding:13px 23px;border-radius:9px;text-decoration:none;font-weight:700;border:1px solid #167f7c;cursor:pointer}
.dental-content .primary{background:#167f7c;color:white}
.dental-content .outline{background:transparent;color:#167f7c}
.dental-content .hours{font-size:.9rem;margin-top:24px;opacity:.75}
.treatments-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:16px;margin-block:28px}
.dental-card{display:block;background:var(--color-surface,#fff);border:1px solid #d4e7e7;border-radius:16px;padding:24px;color:inherit;text-decoration:none;box-shadow:0 5px 24px #173b4209}
.dental-card:hover{border-color:#16908c}
.treatment-icon{font-size:2rem}
.bottom-link{margin-top:24px}
.dental-faq{display:grid;gap:12px}
.dental-faq summary{cursor:pointer;font-weight:700}
.dental-faq details p{margin-top:14px}
.symptom-search,.appointment-request input,.appointment-request select{width:100%;max-width:650px;border:1px solid #bccfcf;padding:12px;border-radius:8px;background:white;color:#173b42}
.symptom-item[hidden]{display:none}
.appointment-request{max-width:620px;display:grid;gap:16px}
.appointment-request label{display:grid;gap:8px}
</style>